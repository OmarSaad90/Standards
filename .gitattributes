# Keep line endings stable across Windows and the Linux build environment.
* text=auto eol=lf

# Byte-exact files. The build verifies the dataset SHA-256 against the value in
# handoffv2/SHA256SUMS.txt, so any line-ending rewrite would fail the gate.
data/public_standards_phase1_v1_0_7.json -text
handoff/** -text
handoffv2/** -text

# Generated, keeps diffs readable
package-lock.json -diff
