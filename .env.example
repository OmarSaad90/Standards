# Environment template for the Aedifica Free Standards Explorer.
# Copy to .env.local for local work, or set these in the Netlify UI for deploys.

# Public origin of the deployed site, no trailing slash.
# Drives canonical URLs, Open Graph URLs, and sitemap.xml.
# Netlify supplies URL automatically, so this is only required once a custom
# domain is attached.
NEXT_PUBLIC_SITE_URL=https://standards.example.com

# No secrets belong in this file.
# 06_SECURITY_BOUNDARY.md: "no secrets in client env vars".
# The public dataset ships in the repository; there is no backend to authenticate to.
